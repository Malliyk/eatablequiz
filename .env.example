# Copy this file to .env and fill in your project's values.
# These two values identify YOUR Lovable Cloud database — find them in
# Lovable under your project's Cloud settings.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
